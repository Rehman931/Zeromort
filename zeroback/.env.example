# Server Port
PORT=5000

# Client Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/watchparty?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/watchparty?retryWrites=true&w=majority
